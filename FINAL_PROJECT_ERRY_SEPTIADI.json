[\n    \"judul_training\",\n    \"sub_judul_training\",\n    \"ringkasan_kebutuhan\",\n    \"tujuan_pelatihan\",\n    \"modul_program\",\n    \"format_dan_durasi\",\n    \"outcome\",\n    \"catatan_internal\"\n  ]\n}"
