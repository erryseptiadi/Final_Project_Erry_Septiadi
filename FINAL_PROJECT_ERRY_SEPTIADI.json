{
  "name": "FINAL PROJECT",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Training Needs Analysis (TNA) – Public Speaking for Corporate",
        "formDescription": "Form ini ditujukan bagi PIC/HR/representative perusahaan untuk membantu kami memahami kebutuhan pengembangan kemampuan public speaking di organisasi Anda.\n\nInformasi yang diberikan akan menjadi dasar dalam menyusun rekomendasi materi, metode, dan bentuk pelatihan yang sesuai dengan kebutuhan perusahaan dan karakteristik peserta.\n\nMohon isi berdasarkan kondisi, kebutuhan, dan tantangan yang saat ini dihadapi oleh tim atau karyawan di perusahaan Anda.\n\nEstimasi waktu pengisian: 5–10 menit.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Nama PIC",
              "requiredField": true
            },
            {
              "fieldLabel": "Jabatan",
              "requiredField": true
            },
            {
              "fieldLabel": "Nama Perusahaan",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "requiredField": true
            },
            {
              "fieldLabel": "Tantangan Saat Ini",
              "placeholder": "Masalah public speaking apa yang paling dirasakan saat ini, dan di situasi apa itu paling sering muncul? (presentasi ke atasan, pitching klien, MC, dll.)",
              "requiredField": true
            },
            {
              "fieldLabel": "Kondisi Saat Ini",
              "placeholder": "Bagaimana level kemampuan/kepercayaan diri peserta saat ini? dan apakah pernah ikut training sejenis sebelumnya?",
              "requiredField": true
            },
            {
              "fieldLabel": "Ekspetasi",
              "placeholder": "Perubahan atau hasil konkret apa yang diharapkan setelah mengikuti training?",
              "requiredField": true
            },
            {
              "fieldLabel": "Gambaran Calon Peserta",
              "placeholder": "Jumlah peserta, Jabatan/level peserta (Staff/Supervisor/Manajer/Eksekutif), Rentang usia",
              "requiredField": true
            },
            {
              "fieldLabel": "Teknis Pelatihan",
              "placeholder": "Preferensi waktu & durasi pelaksanaan dan Format (Offline/Online/Hybrid)",
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
